# Daily Briefing — environment variables
# Copy this file to .env.local and fill in your values:
#   cp .env.local.example .env.local
#
# Bun loads .env.local automatically — no dotenv needed.

# --- Required ---

# OpenAI API key, used for summarization, categorization, and chat.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Secret that protects the aggregation endpoint (/api/cron/aggregate).
# Generate a random value, e.g.:  openssl rand -hex 32
CRON_SECRET=change-me

# --- Optional: cloud storage (Vercel KV) ---
# Leave these UNSET for self-hosting — the app falls back to a local
# JSON file store at data/local.json automatically.
# Set both only if you deploy to Vercel with a KV (Redis) database.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

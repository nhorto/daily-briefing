# Normalize line endings across macOS / Windows / Linux.
# Store text files with LF in the repo and check them out with LF everywhere,
# so switching machines doesn't churn every file.
* text=auto eol=lf

# Binary assets — never normalize.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff  binary
*.woff2 binary
*.lockb binary
